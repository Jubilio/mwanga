# ============================================
# DATABASE CONFIGURATION (PostgreSQL/Supabase)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database_name
# Alternative for Supabase:
# DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-region.sql.supabase.co:5432/postgres

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# Chave dos documentos cifrados (KYC, crédito). 32 bytes: gere com `openssl rand -hex 32`.
# Sem ela, a chave é derivada do JWT_SECRET (mudar o JWT_SECRET deixaria os ficheiros ilegíveis).
FILE_ENCRYPTION_KEY=

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_from_console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# EMAIL (recuperação de senha + emails do admin)
# ============================================
# Opção A, recomendada no Render gratuito (que bloqueia SMTP): Gmail API por HTTPS.
# Passo a passo em docs/EMAIL_GMAIL_API.md. Scope necessário: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=nexovibecontact@gmail.com
EMAIL_FROM_NAME=Mwanga · NexoVibe
# EMAIL_REPLY_TO=
#
# Opção B, só em servidores que permitem SMTP (ex.: Render pago). Gmail: use uma "senha de app".
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=nexovibecontact@gmail.com
# EMAIL_PASS=
# URL pública do backend, usada no link "cancelar subscrição" (no Render, RENDER_EXTERNAL_URL já serve).
# PUBLIC_API_URL=https://mwanga-z1f4.onrender.com
# Ritmo das campanhas: 10 emails a cada 2 minutos, no máximo 450 por 24h (o Gmail gratuito aceita ~500/dia).
# EMAIL_BATCH_SIZE=10
# EMAIL_BATCH_DELAY_MS=120000
# EMAIL_DAILY_LIMIT=450

# ============================================
# REDIS (optional, for caching/sessions)
# ============================================
REDIS_URL=redis://localhost:6379
# Alternative for Upstash:
# REDIS_URL=https://default:password@host.upstash.io

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# CORS & FRONTEND URLS
# ============================================
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://mwanga-opal.vercel.app

# Required for personal AI keys: generate 32 random bytes encoded as 64 hex characters.
# Keep this stable and secret; replacing it makes previously saved keys unreadable.
AI_CREDENTIALS_ENCRYPTION_KEY=
# Optional: public URL of this API, used as the "Ligar com OpenRouter" return address.
# Defaults to the request host (works on Render). Example: https://mwanga-z1f4.onrender.com
# API_PUBLIC_URL=

# WhatsApp (Evolution API). O segredo do webhook é obrigatório: sem ele o webhook recusa tudo.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_PROVIDER=evolution
WHATSAPP_WEBHOOK_SECRET=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Só se WHATSAPP_PROVIDER=twilio
TWILIO_AUTH_TOKEN=

# Native Android push (FCM). Firebase service account JSON on one line.
# See docs/ANDROID_RELEASE.md, "Notificações nativas (Firebase)".
FIREBASE_SERVICE_ACCOUNT=

# AI cost control and telemetry (see docs/BINTH_LIMITES_E_DADOS.md)
# Monthly ceiling in USD for Mwanga's own AI keys. Admins get an email at 80 %;
# at 100 % Mwanga's keys stop until next month (personal keys keep working).
AI_MONTHLY_BUDGET_USD=
# AI_BUDGET_ALERT_RATIO=0.8
# Extra or corrected model prices, USD per million tokens [input, output].
# AI_PRICES_JSON={"gemini-2.5-flash":[0.3,2.5]}
# AI_CALLS_RETENTION_DAYS=180
# Logs: JSON in production automatically; LOG_FORMAT=json forces it locally.
# LOG_LEVEL=info

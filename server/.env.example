# ============================================
# DATABASE CONFIGURATION (PostgreSQL/Supabase)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database_name
# Alternative for Supabase:
# DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-region.sql.supabase.co:5432/postgres

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_from_console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# EMAIL SERVICE (for password reset)
# ============================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=noreply@mwanga.app

# ============================================
# REDIS (optional, for caching/sessions)
# ============================================
REDIS_URL=redis://localhost:6379
# Alternative for Upstash:
# REDIS_URL=https://default:password@host.upstash.io

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# CORS & FRONTEND URLS
# ============================================
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://mwanga-opal.vercel.app

# Required for personal AI keys: generate 32 random bytes encoded as 64 hex characters.
# Keep this stable and secret; replacing it makes previously saved keys unreadable.
AI_CREDENTIALS_ENCRYPTION_KEY=

# ============================================
# PAYSUITE (M-Pesa, e-Mola, cartões)
# ============================================
# Token da API: painel PaySuite > Settings > API Access. Nunca commitar valores reais.
PAYSUITE_API_TOKEN=
# Segredo do webhook (painel PaySuite). Usado para validar o cabeçalho X-Signature.
PAYSUITE_WEBHOOK_SECRET=
# Opcional; por omissão https://paysuite.tech/api/v1
# PAYSUITE_API_URL=https://paysuite.tech/api/v1
# URL pública deste servidor, para a PaySuite chamar /api/payments/webhook.
# Se ficar vazio, usa-se o webhook configurado na conta PaySuite.
API_PUBLIC_URL=
